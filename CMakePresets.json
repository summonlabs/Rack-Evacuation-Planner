{
  "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7dcb8c8a8f1e4d3c/CMakePresets.json",
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release (Ninja)",
      "description": "Optimized Release build with Ninja. Requires cl.exe in the environment (Visual Studio developer shell).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "REP_BUILD_TESTS": "ON",
        "REP_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (Ninja)",
      "description": "Debug build with Ninja. Requires cl.exe in the environment (Visual Studio developer shell).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "REP_BUILD_TESTS": "ON",
        "REP_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "Debug + AddressSanitizer (Ninja)",
      "description": "Debug build with AddressSanitizer enabled. Requires cl.exe in the environment (Visual Studio developer shell).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "REP_BUILD_TESTS": "ON",
        "REP_WARNINGS_AS_ERRORS": "ON",
        "REP_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "release-msvc-vs",
      "displayName": "Release (Visual Studio 17 2022)",
      "description": "Multi-config Visual Studio 2022 build. Usable from an ordinary shell without a developer environment.",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/vs2022",
      "cacheVariables": {
        "REP_BUILD_TESTS": "ON",
        "REP_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "ci",
      "displayName": "CI (Ninja)",
      "description": "Release configuration used for continuous integration; also builds the examples.",
      "inherits": "release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ci",
      "cacheVariables": {
        "REP_BUILD_TESTS": "ON",
        "REP_WARNINGS_AS_ERRORS": "ON",
        "REP_BUILD_EXAMPLES": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "ci",
      "configurePreset": "ci"
    },
    {
      "name": "release-msvc-vs",
      "configurePreset": "release-msvc-vs",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
